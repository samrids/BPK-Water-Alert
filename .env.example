# ===== BPK Water Alert — ตั้งค่า =====
# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ห้ามนำ .env ขึ้น Git / file share)

# Telegram — Token จาก @BotFather, Chat ID จาก https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ส่งหลายกลุ่มได้ คั่นด้วย ,  (กลุ่มมักขึ้นต้นด้วย -100)
TELEGRAM_CHAT_ID=-1001234567890

# สถานีที่เฝ้าระวัง (รหัสจาก thaiwater.net) คั่นด้วย ,  — ค่าเริ่มต้น = 4 สถานีใน จ.ฉะเชิงเทรา
#   BPK001 บางปะกง | BPK003 บางน้ำเปรี้ยว | BPK004 พนมสารคาม | BKK016 ปากคลองพระองค์เจ้าฯ
STATION_CODES=BPK001,BPK003,BPK004,BKK016
# หัวข้อภาพสรุป (เว้นว่าง = "ระดับน้ำ จ.<จังหวัด>")
AREA_TITLE=

# เกณฑ์แจ้งเตือน (หน่วย: เมตร)
NEAR_M=0.30          # เตือนเมื่อห่างตลิ่งน้อยกว่า 30 ซม.
HYSTERESIS_M=0.05    # ต้องลดลงอีก 5 ซม. จากเกณฑ์ ถึงนับว่ากลับปกติ
REPEAT_STEP_M=0.10   # ระหว่างเตือน ถ้าน้ำขึ้นอีก 10 ซม. แจ้งซ้ำ

# ไม่มีค่าใหม่จากสถานีเกินกี่ชั่วโมง -> แจ้งว่าสถานีไม่อัปเดต
STALE_H=2

# ส่งแจ้งเตือนเป็นภาพการ์ด + กราฟย้อนหลัง (0 = ส่งข้อความอย่างเดียว)
ALERT_IMAGE=1
GRAPH_HOURS=24
# ชื่อจุด/ถนนที่ต้องระวังของแต่ละสถานี แสดงบนภาพ (เว้นว่างได้)  ROAD_NAME_<รหัสสถานี>=...
ROAD_NAME_BPK001=
ROAD_NAME_BPK003=
ROAD_NAME_BPK004=
ROAD_NAME_BKK016=

# รายงานประจำวัน (ส่งภาพสถานะทุกวันแม้น้ำปกติ) รูปแบบ HH:MM — เว้นว่าง = ปิด
DAILY_REPORT_TIME=06:30

# ไฟล์เก็บสถานะ (อยู่โฟลเดอร์เดียวกับสคริปต์)
STATE_FILE=bpk_alert_state.json
